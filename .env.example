# Azure OpenAI credentials used by wwi_data_agent.py
# Copy this file to .env and fill in the real values.

# Your Azure OpenAI API key (required)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# Azure OpenAI v1 endpoint (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1

# Model deployment name (required)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# TLS verification: true by default. Set to false only behind a corporate proxy
# that re-signs certificates.
AZURE_OPENAI_VERIFY_SSL=true